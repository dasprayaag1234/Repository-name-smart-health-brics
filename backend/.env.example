# Copy to .env and fill in. Everything here is optional — the app runs on
# SQLite + demo data with none of these set.

# PostgreSQL / Supabase connection string, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Google Gemini API key for the AI assistant. Without it, the assistant
# falls back to a rule-based responder that still answers from real data.
GEMINI_API_KEY=
